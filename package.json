{
  "name": "interview-coach-recruiter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:candidate": "node scripts/dev-candidate.mjs",
    "build": "next build",
    "build:prod": "next build",
    "start": "next start",
    "start:prod": "node scripts/start-production.mjs",
    "lint": "next lint --max-warnings 0",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "test:candidate": "vitest run src/test/smoke.test.tsx src/app/practice2/page.test.tsx src/app/session2/[sessionId]/page.test.tsx src/app/dashboard2/page.test.tsx",
    "test:coverage": "vitest run --coverage",
    "test:stability": "node scripts/run-stability-suite.mjs",
    "test:e2e": "playwright test",
    "test:e2e:candidate-seeded": "node scripts/run-candidate-browser-smoke.mjs",
    "ci:quality": "npm run lint && npm run typecheck && npm run test:coverage",
    "ci:candidate": "npm run lint && npm run typecheck && npm run test:candidate && npm run build",
    "ci:candidate:with-db": "npm run ci:candidate && npm run db:smoke-candidate-readiness && npm run test:e2e:candidate-seeded",
    "auth:provision-user": "node scripts/provision-app-user.mjs",
    "postgres:smoke:start": "node scripts/start-postgres-smoke-db.mjs",
    "db:setup": "npm run postgres:smoke:start && npm run db:migrate && npm run db:seed",
    "db:migrate": "npm run db:apply-schema && npm run db:apply-candidate-schema && npm run db:apply-candidate-drafts-schema && npm run db:apply-candidate-role-profiles-schema && npm run db:backfill-answer-modality",
    "db:apply-schema": "node scripts/run-postgres-sql.mjs --file db/migrations/001_initial_schema.sql --smoke-defaults",
    "db:apply-candidate-schema": "node scripts/run-postgres-sql.mjs --file db/migrations/002_candidate_identity_schema.sql --smoke-defaults",
    "db:apply-candidate-drafts-schema": "node scripts/run-postgres-sql.mjs --file db/migrations/003_candidate_practice_drafts_schema.sql --smoke-defaults",
    "db:apply-candidate-role-profiles-schema": "node scripts/run-postgres-sql.mjs --file db/migrations/004_candidate_role_preparation_profiles_schema.sql --smoke-defaults",
    "db:backfill-answer-modality": "node scripts/run-postgres-sql.mjs --file db/migrations/005_backfill_answer_modality_from_analysis.sql --smoke-defaults",
    "db:seed": "npm run db:seed-candidate-dev",
    "db:seed-candidate-dev": "node scripts/run-postgres-sql.mjs --file db/seeds/001_candidate_dev_seed.sql --smoke-defaults",
    "db:seed-candidate-preview": "node scripts/run-postgres-sql.mjs --file db/seeds/002_candidate_preview_irma_seed.sql",
    "db:smoke-candidate-dev-seed": "node scripts/run-postgres-sql.mjs --file db/validation/004_candidate_dev_seed_smoke.sql --smoke-defaults",
    "db:smoke-candidate-preview-seed": "node scripts/run-postgres-sql.mjs --file db/validation/007_candidate_preview_irma_seed_smoke.sql",
    "db:smoke-schema": "node scripts/run-postgres-sql.mjs --file db/validation/001_initial_schema_smoke.sql --smoke-defaults",
    "db:smoke-candidate-schema": "node scripts/run-postgres-sql.mjs --file db/validation/002_candidate_identity_schema_smoke.sql --smoke-defaults",
    "db:smoke-candidate-drafts-schema": "node scripts/run-postgres-sql.mjs --file db/validation/003_candidate_practice_drafts_schema_smoke.sql --smoke-defaults",
    "db:smoke-candidate-role-profiles-schema": "node scripts/run-postgres-sql.mjs --file db/validation/006_candidate_role_profiles_schema_smoke.sql --smoke-defaults",
    "db:smoke-candidate-setup-summary": "node scripts/run-postgres-sql.mjs --file db/validation/005_candidate_setup_to_summary_smoke.sql --smoke-defaults",
    "db:smoke-candidate-readiness": "npm run db:migrate && npm run db:smoke-candidate-role-profiles-schema && npm run db:seed-candidate-dev && npm run db:smoke-candidate-dev-seed && npm run db:smoke-candidate-setup-summary",
    "postgres:smoke:product": "node scripts/smoke-postgres-product-flow.mjs --smoke-defaults",
    "postgres:smoke:ai": "node scripts/smoke-postgres-ai-surfaces.mjs --smoke-defaults",
    "postgres:smoke:email": "node scripts/smoke-postgres-email-flow.mjs --smoke-defaults",
    "postgres:smoke:practice-again": "node scripts/smoke-postgres-practice-again.mjs --smoke-defaults",
    "postgres:smoke:profile-settings": "node scripts/smoke-postgres-profile-settings.mjs --smoke-defaults",
    "postgres:smoke:resend-retry": "node scripts/smoke-postgres-resend-retry.mjs --smoke-defaults",
    "postgres:smoke:recruiter-review": "node scripts/smoke-postgres-recruiter-review.mjs --smoke-defaults",
    "postgres:smoke:negative-permissions": "node scripts/smoke-postgres-negative-permissions.mjs --smoke-defaults"
  },
  "dependencies": {
    "@google/genai": "1.39.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^9.0.0-rc01",
    "framer-motion": "^12.31.0",
    "lucide-react": "^0.309.0",
    "next": "^15.5.13",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^8.0.5",
    "pg": "^8.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "uuidv7": "^1.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.13",
    "jsdom": "^28.0.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.0",
    "vitest": "^4.0.18"
  }
}
