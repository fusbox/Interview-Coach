{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/icons/**",
              "components/shell/**",
              "components/structure/**",
              "ui_kits/candidate/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Outfit))/i]",
        "message": "Font not provided by the design system. Available: Inter, Outfit."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|secondary|size|disabled|className|type|onClick|children|key|ref|className|style|children)$/]",
        "message": "<ActionButton> doesn't accept that prop. Declared props: href, secondary, size, disabled, className, type, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|large)$/]",
        "message": "<ActionButton> size must be one of 'default' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionButton'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<ActionButton> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|weight|size|icon|key|ref|className|style|children)$/]",
        "message": "<AlertPanel> doesn't accept that prop. Declared props: tone, weight, size, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertPanel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:critical|success|info|warning)$/]",
        "message": "<AlertPanel> tone must be one of 'critical' | 'success' | 'info' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertPanel'] > JSXAttribute[name.name='weight'] > Literal[value!=/^(?:medium|semibold)$/]",
        "message": "<AlertPanel> weight must be one of 'medium' | 'semibold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertPanel'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<AlertPanel> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|secondary|destructive|outline|success|warning|info|high|medium|low|unknown)$/]",
        "message": "<Badge> variant must be one of 'default' | 'secondary' | 'destructive' | 'outline' | 'success' | 'warning' | 'info' | 'high' | 'medium' | 'low' | 'unknown'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|emphasis|density|shape|label|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, emphasis, density, shape, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|destructive|outline|secondary|ghost|link|info)$/]",
        "message": "<Button> variant must be one of 'default' | 'destructive' | 'outline' | 'secondary' | 'ghost' | 'link' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|sm|lg|icon)$/]",
        "message": "<Button> size must be one of 'default' | 'sm' | 'lg' | 'icon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='emphasis'] > Literal[value!=/^(?:primary|secondary|tertiary|danger|link|info)$/]",
        "message": "<Button> emphasis must be one of 'primary' | 'secondary' | 'tertiary' | 'danger' | 'link' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='density'] > Literal[value!=/^(?:compact|default|comfortable|hero)$/]",
        "message": "<Button> density must be one of 'compact' | 'default' | 'comfortable' | 'hero'."
