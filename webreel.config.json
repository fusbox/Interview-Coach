    "review-results-detailed": {
      "url": "/login",
      "steps": [
        { "action": "type", "selector": "input[placeholder='name@company.com']", "text": "user@example.com" },
        { "action": "type", "selector": "input[placeholder='Enter your password']", "text": "oldsch00lhollywoodbaseball!" },
        { "action": "click", "text": "Sign In" },
        { "action": "wait", "selector": "aside" },
        { "action": "navigate", "url": "/recruiter" },
        { "action": "pause", "ms": 1500 },
        { "action": "click", "text": "View Results" },
        { "action": "pause", "ms": 2000 },
        { "action": "scroll", "y": 500 },
        { "action": "click", "text": "Explore Feedback" },
        { "action": "pause", "ms": 2000 }
      ]
