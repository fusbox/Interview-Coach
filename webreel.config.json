{
  "$schema": "https://webreel.dev/schema/v1.json",
  "baseUrl": "http://localhost:3000",
  "defaultDelay": 1200,
  "videos": {
    "recruiter-auth-onboarding": {
      "url": "/login",
      "steps": [
        { "action": "pause", "ms": 2000 },
        { "action": "click", "text": "Create Account" },
        { "action": "wait", "selector": "input[placeholder='Create a strong password']" },
        { "action": "type", "selector": "input[placeholder='name@company.com']", "text": "new-recruiter-demo-5@example.com" },
        { "action": "type", "selector": "input[placeholder='Create a strong password']", "text": "S3cureP@ssw0rd!" },
        { "action": "click", "selector": "button", "text": "Create Account" },
        { "action": "pause", "ms": 3000 },
        { "action": "click", "text": "Sign In" },
        { "action": "wait", "selector": "input[placeholder='Enter your password']" },
        { "action": "type", "selector": "input[placeholder='name@company.com']", "text": "user@example.com" },
        { "action": "type", "selector": "input[placeholder='Enter your password']", "text": "oldsch00lhollywoodbaseball!" },
        { "action": "click", "selector": "button", "text": "Sign In" },
        { "action": "wait", "selector": "aside" },
        { "action": "navigate", "url": "/recruiter/settings" },
        { "action": "pause", "ms": 1500 },
        { "action": "type", "selector": "input[placeholder='e.g. Senior Technical Recruiter']", "text": "Lead Talent Acquisition" },
        { "action": "type", "selector": "input[required]:nth-of-type(1)", "text": "John" },
        { "action": "type", "selector": "input[placeholder='(555) 123-4567']", "text": "(555) 987-6543" },
        { "action": "select", "selector": "select", "value": "America/New_York" },
        { "action": "click", "text": "Save Changes" }
      ]
    },
    "recruiter-dashboard-tour": {
      "url": "/login",
      "steps": [
        { "action": "type", "selector": "input[placeholder='name@company.com']", "text": "user@example.com" },
        { "action": "type", "selector": "input[placeholder='Enter your password']", "text": "oldsch00lhollywoodbaseball!" },
        { "action": "click", "text": "Sign In" },
        { "action": "wait", "selector": "aside" },
        { "action": "pause", "ms": 2000 },
        { "action": "hover", "selector": "a[href='/recruiter/templates']" },
        { "action": "pause", "ms": 1500 },
        { "action": "hover", "selector": "a[href='/recruiter']" },
        { "action": "pause", "ms": 1500 },
        { "action": "hover", "selector": "a[href='/recruiter/settings']" }
      ]
    },
    "create-invite-comprehensive": {
      "url": "/login",
      "steps": [
        { "action": "type", "selector": "input[placeholder='name@company.com']", "text": "user@example.com" },
        { "action": "type", "selector": "input[placeholder='Enter your password']", "text": "oldsch00lhollywoodbaseball!" },
        { "action": "click", "text": "Sign In" },
        { "action": "wait", "selector": "aside" },
        { "action": "pause", "ms": 500 },
        { "action": "type", "selector": "input[placeholder='e.g. RCI-ENG-101']", "text": "RCI-DEMO-001" },
        { "action": "type", "selector": "input[placeholder='e.g. Senior Product Manager']", "text": "Frontend Engineer" },
        { "action": "click", "text": "Next" },
        { "action": "pause", "ms": 1500 },
        { "action": "click", "text": "Back" },
        { "action": "pause", "ms": 1500 },
        { "action": "click", "text": "Next" },
        { "action": "wait", "text": "STAR Questions" },
        { "action": "hover", "selector": ".group\\/field" },
        { "action": "click", "selector": "button[title='Clear content']" },
        { "action": "click", "text": "Next: Add Candidates" },
        { "action": "type", "selector": "input[placeholder='Candidate Name']", "text": "Jane Smith" },
        { "action": "click", "text": "Next: Preview" },
        { "action": "click", "text": "Edit" },
        { "action": "type", "selector": "input[placeholder='e.g. RCI-ENG-101']", "text": "RCI-DEMO-001-UPDATED" },
        { "action": "click", "text": "Save" },
        { "action": "click", "text": "Generate Invites" }
      ]
    },
    "recruiter-template-management": {
      "url": "/login",
      "steps": [
        { "action": "type", "selector": "input[placeholder='name@company.com']", "text": "user@example.com" },
        { "action": "type", "selector": "input[placeholder='Enter your password']", "text": "oldsch00lhollywoodbaseball!" },
        { "action": "click", "text": "Sign In" },
        { "action": "wait", "selector": "aside" },
