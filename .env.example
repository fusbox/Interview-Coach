# Interview Coach Azure staging environment manifest.
# Never commit real credentials. Configure these values in Azure App Settings
# or a secret store. For a local preflight, create the ignored file
# .env.azure-staging.local and run:
#   npm run env:check:azure-staging

# -----------------------------------------------------------------------------
# Shared web app: candidate, invited-candidate, and recruiter routes
# -----------------------------------------------------------------------------

# One canonical, browser-addressable HTTPS origin. Keep both values identical.
NEXT_PUBLIC_APP_URL=https://<azure-staging-host>
CANDIDATE_ACCOUNT_PUBLIC_ORIGIN=https://<azure-staging-host>

# Deployed PostgreSQL runtime URI. The application must connect as the
# non-owner interview_coach_runtime role with TLS enabled.
DATABASE_URL=

# Optional bounded PostgreSQL runtime controls.
POSTGRES_POOL_MAX=2
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_STATEMENT_TIMEOUT_MS=15000
POSTGRES_QUERY_TIMEOUT_MS=20000
POSTGRES_SSL_MODE=
POSTGRES_SSL_REJECT_UNAUTHORIZED=
POSTGRES_APPLICATION_NAME=interview-coach-v2

# App-owned recruiter authentication.
AUTH_COOKIE_NAME=ic_app_session
APP_SESSION_TTL_SECONDS=28800

# Recruiter invitation token protection and invited-candidate access.
ENCRYPTION_SECRET=
RECRUITER_INVITE_TOKEN_TTL_SECONDS=1209600
INVITED_PRACTICE_ACCESS_TTL_SECONDS=604800

# Shared SMTP transport for recruiter invitations and candidate account email.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=interviews@coach.rangam.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=Rangam Interview Coach <interviews@coach.rangam.com>
RECRUITER_INVITATION_DELIVERY_PROVIDER=smtp
CANDIDATE_ACCOUNT_EMAIL_PROVIDER=smtp
CANDIDATE_ACCOUNT_FROM_EMAIL=TalentArbor Interview Coach <interviews@coach.rangam.com>

# App-owned candidate verification, recovery, and immutable consent receipts.
CANDIDATE_EMAIL_VERIFICATION_TTL_SECONDS=86400
CANDIDATE_PASSWORD_RESET_TTL_SECONDS=1800
CANDIDATE_TERMS_VERSION=
CANDIDATE_PRIVACY_VERSION=
CANDIDATE_COOKIE_VERSION=
CANDIDATE_RESPONSIBLE_AI_VERSION=
CANDIDATE_CONTACT_AUTHORIZATION_VERSION=

# Approved Gemini adapters and profile identities.
GEMINI_API_KEY=
CANDIDATE_QUESTION_WORDING_PROVIDER=google_genai
CANDIDATE_QUESTION_WORDING_PROFILE=google_gemini_2_5_flash_question_wording_v2
CANDIDATE_QUESTION_ASSISTANCE_PROVIDER=google_genai
CANDIDATE_QUESTION_ASSISTANCE_PROFILE=google_gemini_2_5_flash_question_assistance_v1
CANDIDATE_ANSWER_ANALYSIS_PROVIDER=google_genai
CANDIDATE_ANSWER_ANALYSIS_PROFILE=google_gemini_2_5_flash_v1
CANDIDATE_COACH_UPDATE_PROVIDER=google_genai
CANDIDATE_COACH_UPDATE_PROFILE=google_gemini_2_5_flash_coach_update_v4
SESSION_QUESTION_AUDIO_PROVIDER=google_genai
SESSION_QUESTION_AUDIO_PROFILE=google_gemini_2_5_flash_tts_v1
SESSION_VOICE_TRANSCRIPTION_PROVIDER=google_genai
SESSION_VOICE_TRANSCRIPTION_PROFILE=google_gemini_2_5_flash_voice_transcription_v1
CANDIDATE_RESUME_OCR_PROVIDER=google_genai
CANDIDATE_RESUME_OCR_PROFILE=google_gemini_2_5_flash_resume_photo_ocr_v1

# Azure staging must keep local launch and provider fixtures disabled.
CANDIDATE_HOST_LAUNCH_DEV_MODE=false
CANDIDATE_RESUME_OCR_FIXTURE_ENABLED=false
SESSION_VOICE_TRANSCRIPTION_FIXTURE_ENABLED=false

# -----------------------------------------------------------------------------
# TalentArbor host launch and direct MSSQL context lookup
# -----------------------------------------------------------------------------

CANDIDATE_HOST_LAUNCH_SECRET=
CANDIDATE_HOST_LAUNCH_EXPECTED_ISSUER=
CANDIDATE_HOST_LAUNCH_EXPECTED_WORKSPACE=talentarbor
CANDIDATE_HOST_LAUNCH_CLOCK_SKEW_SECONDS=30
CANDIDATE_HOST_LAUNCH_MAX_TOKEN_LIFETIME_SECONDS=120
CANDIDATE_HOST_LAUNCH_SESSION_TTL_SECONDS=604800

CANDIDATE_HOST_LAUNCH_TA_SQL_SERVER=
CANDIDATE_HOST_LAUNCH_TA_SQL_PORT=1433
CANDIDATE_HOST_LAUNCH_TA_SQL_DATABASE=
CANDIDATE_HOST_LAUNCH_TA_SQL_USER=
CANDIDATE_HOST_LAUNCH_TA_SQL_PASSWORD=
CANDIDATE_HOST_LAUNCH_TA_SQL_ENCRYPT=true
CANDIDATE_HOST_LAUNCH_TA_SQL_TRUST_SERVER_CERTIFICATE=false
CANDIDATE_HOST_LAUNCH_TA_SQL_CONNECT_TIMEOUT_MS=5000
CANDIDATE_HOST_LAUNCH_TA_SQL_REQUEST_TIMEOUT_MS=8000
CANDIDATE_HOST_LAUNCH_TA_SQL_POOL_MAX=4
